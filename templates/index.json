{
  "name": "jingge-ppt-template-library",
  "version": "0.1.0",
  "workflow": "Read style-routing.json first: honor requested styles and existing deck continuity; for a new unspecified deck select a premium baseline by scenario. Generate content IR, copy a complete matching deck, then fill semantic layouts and optional assets.",
  "catalogs": {
    "themes": "themes/theme-catalog.json",
    "fullDecks": "full-decks/deck-catalog.json",
    "singlePageLayouts": "single-page-layouts/layout-catalog.json",
    "animations": "animations/animation-catalog.json",
    "components": "components/component-catalog.json",
    "styleRouting": "style-routing.json"
  },
  "schemas": {
    "contentIr": "schemas/content-ir.schema.json",
    "template": "schemas/template.schema.json"
  },
  "contentIr": {
    "example": "content-ir/content-ir.example.json",
    "rule": "Generate content IR before rendering HTML, Typst, or export artifacts.",
    "imageCompositionExample": "content-ir/image-composition.example.json"
  },
  "runtime": {
    "slideLifecycle": "runtime/slide-lifecycle.js",
    "canvasFxRuntime": "runtime/canvas-fx-runtime.js",
    "editMode": "runtime/edit-mode.js",
    "gestureController": "features/gesture-controller.js",
    "lifecycleEvents": [
      "Reveal slidechanged",
      "deck:slidechange"
    ],
    "premium": "full-decks/_shared/premium-runtime.js"
  },
  "exporters": {
    "html": "exporters/html",
    "pdf": "exporters/pdf",
    "typst": "exporters/typst"
  },
  "featureFlags": {
    "gesture": [
      "off",
      "motion-lite",
      "mediapipe-hand"
    ],
    "presenterMode": [
      true,
      false
    ],
    "editable": [
      true,
      false
    ],
    "typstHandout": [
      true,
      false
    ]
  },
  "targetLibraryShape": {
    "fullDecks": 25,
    "singlePageLayouts": 42,
    "cssAnimations": 27,
    "canvasFx": 20
  },
